# Copie para .env e ajuste. O arquivo .env e lido automaticamente pelo
# docker compose e nao vai para o repositorio: cada maquina tem o seu.
#
#     cp .env.example .env
#
# Sem .env a loja sobe com os padroes abaixo, em modo de desenvolvimento.

# Endereco canonico da loja, com barra no final.
# Vazio, a URL e derivada do cabecalho Host da requisicao: a loja responde
# por IP, hostname ou qualquer nome, sem reconfiguracao. Conveniente para
# desenvolver, inseguro em dominio publico, porque o cabecalho e controlado
# pelo cliente e um Host forjado gera links para o dominio do atacante.
# Preencha ao publicar.
STORE_URL=

# Porta HTTP no host. Troque para rodar mais de uma loja na mesma maquina.
HTTP_PORT=8080

# URL usada quando nao ha requisicao HTTP: instalacao inicial e execucoes
# por linha de comando (cron). Acompanha o HTTP_PORT automaticamente; so
# preencha se a loja for acessada por outro nome que nao localhost.
# HTTP_SERVER=http://localhost:8080/

# Credenciais do primeiro usuario da administracao, criadas na instalacao.
# Troque antes de subir uma loja publica.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Banco de dados. Aplicado tanto na loja quanto no container do MySQL, e so
# tem efeito na primeira subida, quando o volume do banco e criado.
DB_USERNAME=store
DB_PASSWORD=store
DB_DATABASE=opencartbrasil
